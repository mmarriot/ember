{
  "name": "hgcal",
  "note": "HGCal/TICL reconstruction: NanoAOD tables of CMSSW step3 (Ember's earlier whole-detector export, with DPGAnalysis/HGCalNanoAOD, or NANO:@HGCAL; a stock release writes the legacy collections, CLUE3D tracksters and the candidates' own tracksters, table ticlCandidate; a TICL v6 development export adds SoA collections, CLUEstering tracksters and interpretations), with truth from truth::Graph when present (particles, vertices, reco <-> truth associations of the TruthGraphAssociatorProducers: AdaptiveNominal, TruthToReco), kept to in-time pile-up: particles of bunch crossing 0 and their production and decay vertices (reco objects whose best match is out-of-time are left unmatched, and hit energy from other crossings is unattributed). Caveats: where a file has both, only the SoA objects are written (legacy hits are still read for the SoA hits' cell size); the table ticlCandidateToTruth is the association of the candidates' tracksters when the file has them (a stock release), and of the candidates themselves otherwise (a development export: relation key unless); legacy layer clusters and CLUEstering tracksters that copy SoA ones are checked and dropped (sameRows); legacy trackster axes are read as (x, z, y) because HGCalNanoAOD swaps eVector0_y/z; tracks are drawn straight to their HGCal entry; above the 0.035 GeV rechit cut SoA and legacy rechits agree.",
  "exclude": ["Sim*", "Reco*2Sim*", "ticlSim*", "HGCalGenPart", "TICLCandidatesTrackIdxs", "TICLCandidatesGsfTrackIdxs"],
  "internal": ["ticlCandidatevertices", "linkedTracksters", "HGCalLayerClusterHits", "HGCalLayerClusterSoAHitsEE", "HGCalLayerClusterSoAHitsHSi", "HGCalLayerClusterSoAHitsHSci",
               "TICLSoATrackstersLCOffsets", "TICLSoATrackstersLCs", "ticlTrackstersCLUE3DHighvertices", "ticlTrackstersCLUEsteringvertices",
               "ticlTracksterLinksvertices", "ticlTracksterLinksSuperclusteringDNNvertices", "ticlTracksterInterpretationsvertices",
               "TICLCandidatesExtra",
               "TruthParticleChildren", "TruthHGCalHits", "TruthSoAHitsEE", "TruthSoAHitsHSi", "TruthSoAHitsHSci", "ticlTrackstersCLUE3DHighToTruth", "ticlTrackstersCLUE3DHighFromTruth", "ticlTrackstersCLUEsteringToTruth", "ticlTrackstersCLUEsteringFromTruth", "ticlTracksterLinksToTruth", "ticlTracksterLinksFromTruth", "ticlTracksterLinksSuperclusteringDNNToTruth", "ticlTracksterLinksSuperclusteringDNNFromTruth", "ticlTracksterInterpretationsToTruth", "ticlTracksterInterpretationsFromTruth", "ticlCandidateToTruth", "ticlCandidateFromTruth", "generalTracksToTruth", "generalTracksFromTruth"],
  "sameRows": [
    {"keep": "HGCalSoALayerClusters", "drop": "HGCalLayerClusters", "columns": [["energy", "energy"], ["x", "position_x"]]},
    {"keep": "TICLSoATracksters", "drop": "ticlTrackstersCLUEstering", "columns": [["rawEnergy", "raw_energy"], ["x", "barycenter_x"]]}
  ],
  "derive": [
    {"table": "HGCalSoARecHitsHSci", "xyFromEtaPhiZ": ["eta", "phi", "z"]},
    {"table": "HGCalSoARecHitsEE", "gather": [{"relation": "soaLegacyEE", "columns": {"halfWidth": "halfWidth"}}], "fill": 0.4},
    {"table": "HGCalSoARecHitsHSi", "gather": [{"relation": "soaLegacyHSi", "columns": {"halfWidth": "halfWidth"}}], "fill": 0.4},
    {"table": "HGCalSoARecHitsHSci", "gather": [{"relation": "soaLegacyHSci", "columns": {"halfWidth": "halfWidth"}}], "fill": 0.4},
    {"table": "TICLCandidates", "gather": [
      {"relation": "candidateTrackster", "columns": {"x": "barycenter_x", "y": "barycenter_y", "z": "barycenter_z",
        "axis_x": "eVector0_x", "axis_y": "eVector0_z", "axis_z": "eVector0_y", "ev1": "EV1", "ev2": "EV2", "ev3": "EV3"}},
      {"relation": "candidateOwnTrackster", "columns": {"x": "barycenter_x", "y": "barycenter_y", "z": "barycenter_z",
        "axis_x": "eVector0_x", "axis_y": "eVector0_z", "axis_z": "eVector0_y", "ev1": "EV1", "ev2": "EV2", "ev3": "EV3"}},
      {"relation": "candidateTrack", "columns": {"x": "hgcal_x", "y": "hgcal_y", "z": "hgcal_z"}}
    ]}
  ],
  "relations": [
    {"name": "soaTracksterLCs", "kind": "offsets", "from": "TICLSoATracksters", "to": "HGCalSoALayerClusters",
     "offsets": "TICLSoATrackstersLCOffsets.offset", "indices": "TICLSoATrackstersLCs.layerCluster"},
    {"name": "lcHits", "kind": "links", "from": "HGCalLayerClusters", "to": "HGCalHits", "table": "HGCalLayerClusterHits",
     "fromIndex": "HGCalLayerClusterHits.clusterIdx", "toIndex": "HGCalLayerClusterHits.hitIdx",
     "weights": ["HGCalLayerClusterHits.fraction"]},
    {"name": "lcSoAHitsEE", "kind": "links", "from": "HGCalLayerClusters", "to": "HGCalSoARecHitsEE", "table": "HGCalLayerClusterSoAHitsEE",
     "fromIndex": "HGCalLayerClusterSoAHitsEE.clusterIdx", "toIndex": "HGCalLayerClusterSoAHitsEE.hitIdx",
     "weights": ["HGCalLayerClusterSoAHitsEE.fraction"]},
    {"name": "lcSoAHitsHSi", "kind": "links", "from": "HGCalLayerClusters", "to": "HGCalSoARecHitsHSi", "table": "HGCalLayerClusterSoAHitsHSi",
     "fromIndex": "HGCalLayerClusterSoAHitsHSi.clusterIdx", "toIndex": "HGCalLayerClusterSoAHitsHSi.hitIdx",
     "weights": ["HGCalLayerClusterSoAHitsHSi.fraction"]},
    {"name": "lcSoAHitsHSci", "kind": "links", "from": "HGCalLayerClusters", "to": "HGCalSoARecHitsHSci", "table": "HGCalLayerClusterSoAHitsHSci",
     "fromIndex": "HGCalLayerClusterSoAHitsHSci.clusterIdx", "toIndex": "HGCalLayerClusterSoAHitsHSci.hitIdx",
     "weights": ["HGCalLayerClusterSoAHitsHSci.fraction"]},
    {"name": "clue3dLCs", "kind": "counts", "from": "ticlTrackstersCLUE3DHigh", "to": "HGCalLayerClusters",
     "counts": "ticlTrackstersCLUE3DHigh.nticlTrackstersCLUE3DHighvertices",
     "indices": "ticlTrackstersCLUE3DHighvertices.vertices", "weights": ["ticlTrackstersCLUE3DHighvertices.vertex_mult"]},
    {"name": "clusteringLCs", "kind": "counts", "from": "ticlTrackstersCLUEstering", "to": "HGCalLayerClusters",
     "counts": "ticlTrackstersCLUEstering.nticlTrackstersCLUEsteringvertices",
     "indices": "ticlTrackstersCLUEsteringvertices.vertices", "weights": ["ticlTrackstersCLUEsteringvertices.vertex_mult"]},
    {"name": "linksLCs", "kind": "counts", "from": "ticlTracksterLinks", "to": "HGCalLayerClusters",
     "counts": "ticlTracksterLinks.nticlTracksterLinksvertices",
     "indices": "ticlTracksterLinksvertices.vertices", "weights": ["ticlTracksterLinksvertices.vertex_mult"]},
    {"name": "superclusterLCs", "kind": "counts", "from": "ticlTracksterLinksSuperclusteringDNN", "to": "HGCalLayerClusters",
     "counts": "ticlTracksterLinksSuperclusteringDNN.nticlTracksterLinksSuperclusteringDNNvertices",
     "indices": "ticlTracksterLinksSuperclusteringDNNvertices.vertices",
     "weights": ["ticlTracksterLinksSuperclusteringDNNvertices.vertex_mult"]},
    {"name": "interpretationLCs", "kind": "counts", "from": "ticlTracksterInterpretations", "to": "HGCalLayerClusters",
     "counts": "ticlTracksterInterpretations.nticlTracksterInterpretationsvertices",
     "indices": "ticlTracksterInterpretationsvertices.vertices",
     "weights": ["ticlTracksterInterpretationsvertices.vertex_mult"]},
    {"name": "candidateTrackster", "kind": "counts", "from": "TICLCandidates", "to": "ticlTracksterInterpretations",
     "counts": "TICLCandidates.nTICLCandidatesExtra", "indices": "TICLCandidatesExtra.tracksterIndex"},
    {"name": "candidateOwnTrackster", "kind": "counts", "from": "TICLCandidates", "to": "ticlCandidate",
     "counts": "TICLCandidates.nTICLCandidatesExtra", "indices": "TICLCandidatesExtra.tracksterIndex"},
    {"name": "ownTracksterLCs", "kind": "counts", "from": "ticlCandidate", "to": "HGCalLayerClusters",
     "counts": "ticlCandidate.nticlCandidatevertices",
     "indices": "ticlCandidatevertices.vertices", "weights": ["ticlCandidatevertices.vertex_mult"]},
    {"name": "candidateLinkedTracksters", "kind": "counts", "from": "TICLCandidates", "to": "ticlTracksterLinks",
     "counts": "TICLCandidates.nLinkedTracksters", "indices": "linkedTracksters.tracksterIndex"},
    {"name": "candidateTrack", "kind": "index", "from": "TICLCandidates", "to": "GeneralTrack", "index": "TICLCandidates.trackIdx"},
    {"name": "muonTrack", "kind": "index", "from": "TrackMuonInfo", "to": "GeneralTrack", "index": "TrackMuonInfo.trackIdx"},
    {"name": "soaLegacyEE", "kind": "key", "from": "HGCalSoARecHitsEE", "to": "HGCalHits", "fromKey": "HGCalSoARecHitsEE.detId", "toKey": "HGCalHits.detId"},
    {"name": "soaLegacyHSi", "kind": "key", "from": "HGCalSoARecHitsHSi", "to": "HGCalHits", "fromKey": "HGCalSoARecHitsHSi.detId", "toKey": "HGCalHits.detId"},
    {"name": "soaLegacyHSci", "kind": "key", "from": "HGCalSoARecHitsHSci", "to": "HGCalHits", "fromKey": "HGCalSoARecHitsHSci.detId", "toKey": "HGCalHits.detId"},
    {"name": "truthChildren", "kind": "links", "from": "TruthParticles", "to": "TruthParticles", "table": "TruthParticleChildren",
     "fromIndex": "TruthParticleChildren.parentIdx", "toIndex": "TruthParticleChildren.childIdx"},
    {"name": "truthDecayVertex", "kind": "index", "from": "TruthParticles", "to": "TruthVertices", "index": "TruthParticles.decayVertex"},
    {"name": "truthProdVertex", "kind": "index", "from": "TruthParticles", "to": "TruthVertices", "index": "TruthParticles.prodVertex"},
    {"name": "clusteringTruth", "kind": "links", "from": "ticlTrackstersCLUEstering", "to": "TruthParticles", "table": "ticlTrackstersCLUEsteringToTruth",
     "fromIndex": "ticlTrackstersCLUEsteringToTruth.recoIdx", "toIndex": "ticlTrackstersCLUEsteringToTruth.truthIdx", "weights": ["ticlTrackstersCLUEsteringToTruth.sharedEnergy", "ticlTrackstersCLUEsteringToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"}, "match": {"measure": "energy", "in": "HGCal", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["rawEnergy", "raw_energy"], "good": 0.5}},
    {"name": "truthClusterings", "kind": "links", "from": "TruthParticles", "to": "ticlTrackstersCLUEstering", "table": "ticlTrackstersCLUEsteringFromTruth",
     "fromIndex": "ticlTrackstersCLUEsteringFromTruth.truthIdx", "toIndex": "ticlTrackstersCLUEsteringFromTruth.recoIdx", "weights": ["ticlTrackstersCLUEsteringFromTruth.sharedFraction", "ticlTrackstersCLUEsteringFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"}, "match": {"measure": "energy", "in": "HGCal", "completeness": {"weight": "sharedFraction"}}},
    {"name": "clue3dTruth", "kind": "links", "from": "ticlTrackstersCLUE3DHigh", "to": "TruthParticles", "table": "ticlTrackstersCLUE3DHighToTruth",
     "fromIndex": "ticlTrackstersCLUE3DHighToTruth.recoIdx", "toIndex": "ticlTrackstersCLUE3DHighToTruth.truthIdx", "weights": ["ticlTrackstersCLUE3DHighToTruth.sharedEnergy", "ticlTrackstersCLUE3DHighToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"}, "match": {"measure": "energy", "in": "HGCal", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["raw_energy"], "good": 0.5}},
    {"name": "truthClue3d", "kind": "links", "from": "TruthParticles", "to": "ticlTrackstersCLUE3DHigh", "table": "ticlTrackstersCLUE3DHighFromTruth",
     "fromIndex": "ticlTrackstersCLUE3DHighFromTruth.truthIdx", "toIndex": "ticlTrackstersCLUE3DHighFromTruth.recoIdx", "weights": ["ticlTrackstersCLUE3DHighFromTruth.sharedFraction", "ticlTrackstersCLUE3DHighFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"}, "match": {"measure": "energy", "in": "HGCal", "completeness": {"weight": "sharedFraction"}}},
    {"name": "linksTruth", "kind": "links", "from": "ticlTracksterLinks", "to": "TruthParticles", "table": "ticlTracksterLinksToTruth",
     "fromIndex": "ticlTracksterLinksToTruth.recoIdx", "toIndex": "ticlTracksterLinksToTruth.truthIdx", "weights": ["ticlTracksterLinksToTruth.sharedEnergy", "ticlTracksterLinksToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"}, "match": {"measure": "energy", "in": "HGCal", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["raw_energy"], "good": 0.5}},
    {"name": "truthLinked", "kind": "links", "from": "TruthParticles", "to": "ticlTracksterLinks", "table": "ticlTracksterLinksFromTruth",
     "fromIndex": "ticlTracksterLinksFromTruth.truthIdx", "toIndex": "ticlTracksterLinksFromTruth.recoIdx", "weights": ["ticlTracksterLinksFromTruth.sharedFraction", "ticlTracksterLinksFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"}, "match": {"measure": "energy", "in": "HGCal", "completeness": {"weight": "sharedFraction"}}},
    {"name": "superclusterTruth", "kind": "links", "from": "ticlTracksterLinksSuperclusteringDNN", "to": "TruthParticles", "table": "ticlTracksterLinksSuperclusteringDNNToTruth",
     "fromIndex": "ticlTracksterLinksSuperclusteringDNNToTruth.recoIdx", "toIndex": "ticlTracksterLinksSuperclusteringDNNToTruth.truthIdx", "weights": ["ticlTracksterLinksSuperclusteringDNNToTruth.sharedEnergy", "ticlTracksterLinksSuperclusteringDNNToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"}, "match": {"measure": "energy", "in": "HGCal", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["raw_energy"], "good": 0.5}},
    {"name": "truthSuperclusters", "kind": "links", "from": "TruthParticles", "to": "ticlTracksterLinksSuperclusteringDNN", "table": "ticlTracksterLinksSuperclusteringDNNFromTruth",
     "fromIndex": "ticlTracksterLinksSuperclusteringDNNFromTruth.truthIdx", "toIndex": "ticlTracksterLinksSuperclusteringDNNFromTruth.recoIdx", "weights": ["ticlTracksterLinksSuperclusteringDNNFromTruth.sharedFraction", "ticlTracksterLinksSuperclusteringDNNFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"}, "match": {"measure": "energy", "in": "HGCal", "completeness": {"weight": "sharedFraction"}}},
    {"name": "interpretationTruth", "kind": "links", "from": "ticlTracksterInterpretations", "to": "TruthParticles", "table": "ticlTracksterInterpretationsToTruth",
     "fromIndex": "ticlTracksterInterpretationsToTruth.recoIdx", "toIndex": "ticlTracksterInterpretationsToTruth.truthIdx", "weights": ["ticlTracksterInterpretationsToTruth.sharedEnergy", "ticlTracksterInterpretationsToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"}, "match": {"measure": "energy", "in": "HGCal", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["raw_energy"], "good": 0.5}},
    {"name": "truthInterpretations", "kind": "links", "from": "TruthParticles", "to": "ticlTracksterInterpretations", "table": "ticlTracksterInterpretationsFromTruth",
     "fromIndex": "ticlTracksterInterpretationsFromTruth.truthIdx", "toIndex": "ticlTracksterInterpretationsFromTruth.recoIdx", "weights": ["ticlTracksterInterpretationsFromTruth.sharedFraction", "ticlTracksterInterpretationsFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"}, "match": {"measure": "energy", "in": "HGCal", "completeness": {"weight": "sharedFraction"}}},
    {"name": "candidateTruth", "kind": "links", "from": "TICLCandidates", "to": "TruthParticles", "table": "ticlCandidateToTruth", "unless": ["ticlCandidate"],
     "fromIndex": "ticlCandidateToTruth.recoIdx", "toIndex": "ticlCandidateToTruth.truthIdx", "weights": ["ticlCandidateToTruth.sharedEnergy", "ticlCandidateToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"}, "match": {"measure": "energy", "in": "HGCal", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["raw_energy"], "good": 0.5}},
    {"name": "truthCandidates", "kind": "links", "from": "TruthParticles", "to": "TICLCandidates", "table": "ticlCandidateFromTruth", "unless": ["ticlCandidate"],
     "fromIndex": "ticlCandidateFromTruth.truthIdx", "toIndex": "ticlCandidateFromTruth.recoIdx", "weights": ["ticlCandidateFromTruth.sharedFraction", "ticlCandidateFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"}, "match": {"measure": "energy", "in": "HGCal", "completeness": {"weight": "sharedFraction"}}},
    {"name": "ownTracksterTruth", "kind": "links", "from": "ticlCandidate", "to": "TruthParticles", "table": "ticlCandidateToTruth",
     "fromIndex": "ticlCandidateToTruth.recoIdx", "toIndex": "ticlCandidateToTruth.truthIdx", "weights": ["ticlCandidateToTruth.sharedEnergy", "ticlCandidateToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"}, "match": {"measure": "energy", "in": "HGCal", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["raw_energy"], "good": 0.5}},
    {"name": "truthOwnTracksters", "kind": "links", "from": "TruthParticles", "to": "ticlCandidate", "table": "ticlCandidateFromTruth",
     "fromIndex": "ticlCandidateFromTruth.truthIdx", "toIndex": "ticlCandidateFromTruth.recoIdx", "weights": ["ticlCandidateFromTruth.sharedFraction", "ticlCandidateFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"}, "match": {"measure": "energy", "in": "HGCal", "completeness": {"weight": "sharedFraction"}}},
    {"name": "trackTruth", "kind": "links", "from": "GeneralTrack", "to": "TruthParticles", "table": "generalTracksToTruth",
     "fromIndex": "generalTracksToTruth.recoIdx", "toIndex": "generalTracksToTruth.truthIdx", "weights": ["generalTracksToTruth.sharedEnergy", "generalTracksToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"}, "match": {"measure": "hits", "in": "tracker", "target": "trackerHits", "shared": "sharedEnergy", "over": ["nPixelHits + nOTHits", "nhits"], "good": 0.75}},
    {"name": "truthTracks", "kind": "links", "from": "TruthParticles", "to": "GeneralTrack", "table": "generalTracksFromTruth",
     "fromIndex": "generalTracksFromTruth.truthIdx", "toIndex": "generalTracksFromTruth.recoIdx", "weights": ["generalTracksFromTruth.sharedFraction", "generalTracksFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"}, "match": {"measure": "hits", "in": "tracker", "completeness": {"weight": "score", "complement": true}}},
    {"name": "truthHitsHGCal", "kind": "links", "from": "TruthParticles", "to": "HGCalHits", "table": "TruthHGCalHits",
     "fromIndex": "TruthHGCalHits.particleIdx", "toIndex": "TruthHGCalHits.hitIdx", "weights": ["TruthHGCalHits.simEnergy"],
     "association": true, "best": {"weight": "simEnergy", "order": "max"}, "fact": {"in": "HGCal"}},
    {"name": "truthHitsSoAEE", "kind": "links", "from": "TruthParticles", "to": "HGCalSoARecHitsEE", "table": "TruthSoAHitsEE",
     "fromIndex": "TruthSoAHitsEE.particleIdx", "toIndex": "TruthSoAHitsEE.hitIdx", "weights": ["TruthSoAHitsEE.simEnergy"],
     "association": true, "best": {"weight": "simEnergy", "order": "max"}, "fact": {"in": "HGCal"}},
    {"name": "truthHitsSoAHSi", "kind": "links", "from": "TruthParticles", "to": "HGCalSoARecHitsHSi", "table": "TruthSoAHitsHSi",
     "fromIndex": "TruthSoAHitsHSi.particleIdx", "toIndex": "TruthSoAHitsHSi.hitIdx", "weights": ["TruthSoAHitsHSi.simEnergy"],
     "association": true, "best": {"weight": "simEnergy", "order": "max"}, "fact": {"in": "HGCal"}},
    {"name": "truthHitsSoAHSci", "kind": "links", "from": "TruthParticles", "to": "HGCalSoARecHitsHSci", "table": "TruthSoAHitsHSci",
     "fromIndex": "TruthSoAHitsHSci.particleIdx", "toIndex": "TruthSoAHitsHSci.hitIdx", "weights": ["TruthSoAHitsHSci.simEnergy"],
     "association": true, "best": {"weight": "simEnergy", "order": "max"}, "fact": {"in": "HGCal"}},
    {"name": "candidateLCs", "kind": "compose", "from": "TICLCandidates", "to": "HGCalLayerClusters",
     "via": ["candidateTrackster", "interpretationLCs"]},
    {"name": "candidateOwnLCs", "kind": "compose", "from": "TICLCandidates", "to": "HGCalLayerClusters",
     "via": ["candidateOwnTrackster", "ownTracksterLCs"]}
  ],
  "cuts": {"TICLCandidates": [{"defined": "x"}], "GeneralTrack": [{"reachedBy": "candidateTrack"}],
           "TruthParticles": [["bunchCrossing", "==", 0]], "TruthVertices": [{"reachedBy": ["truthProdVertex", "truthDecayVertex"]}]},
  "prefer": ["SoA", "legacy"],
  "order": ["candidate", "candidateTrackster", "interpretation", "linkedTrackster", "trackster", "layerCluster", "rechit", "track"],
  "stages": ["trackster", "linkedTrackster", "interpretation", "candidateTrackster", "candidate"],
  "kinds": {
    "rechit": {"label": "Hits", "domain": "HGCal", "repr": "cells", "palette": "heat", "visible": true,
               "cut": {"group": "Hit energy", "unit": "GeV", "default": 0.035}},
    "layerCluster": {"label": "Layer clusters", "domain": "HGCal", "repr": "markers", "palette": "cool", "visible": true,
                     "truthGap": {"reason": "the truth graph has no layer-cluster associator (its hits carry the simulated energy)", "gap": 1},
                     "cut": {"group": "Layer cluster energy", "unit": "GeV", "default": 0.0}},
    "trackster": {"label": "Tracksters", "doc": "Showers as TICL's pattern recognition first builds them: layer clusters connected across layers (CLUE3D, ticlTrackstersCLUE3DHigh; CLUEstering in a TICL v6 export). The linking step then joins them, with the recovery step's tracksters (not drawn), into linked tracksters.", "domain": "HGCal", "repr": "ellipsoids", "colourBy": "row", "visible": true},
    "linkedTrackster": {"label": "Linked tracksters", "doc": "Tracksters joined by TICL's linking step: the pieces of one shower made one (TracksterLinksProducer, ticlTracksterLinks, from the CLUE3D tracksters and the recovery step's, which are not drawn: a linked trackster can hold layer clusters of no trackster drawn here), or an electron or photon seed with the tracksters around it (superclustering DNN). No relation says which tracksters each one joined: the viewer relates them by their shared layer clusters.", "domain": "HGCal", "repr": "ellipsoids", "shape": "shell", "colourBy": "row", "visible": true},
    "interpretation": {"label": "Interpretations", "doc": "In a TICL v6 development export, the tracksters of TICL's interpretation step, one per TICL candidate (ticlTracksterInterpretations). A stock release writes the candidate tracksters instead.", "domain": "HGCal", "repr": "ellipsoids", "shape": "cage", "colourBy": "row", "visible": true},
    "candidateTrackster": {"label": "Candidate tracksters", "doc": "Each TICL candidate's own trackster, written by the candidates' producer (TICLCandidateProducer, ticlCandidate) next to them. A charged candidate's is the linked tracksters that match its track in position, time and energy, merged into one; a muon's, the minimum-ionising trackster the muon pass found on its track, if any; each linked trackster left over is copied as a neutral candidate's. Their axes, energy and particle type are then worked out again. One per candidate, except a muon with no such trackster.", "domain": "HGCal", "repr": "ellipsoids", "shape": "cage", "colourBy": "row", "visible": true},
    "candidate": {"label": "Candidates", "doc": "TICL's particles (TICLCandidateProducer): a track with its candidate trackster (charged), a candidate trackster alone (neutral), or a muon from its track (with the minimum-ionising trackster on it, if found). Particle flow's HGCal candidates are made from them.", "domain": "HGCal", "repr": "ellipsoids", "shape": "core", "visible": true,
                  "truthGap": {"reason": "the truth graph has no TICL-candidate associator: the trackster each candidate is built on (a candidate trackster) has its own match, and a charged candidate's track has its own"},
                  "colourBy": {"category": "pdgID", "abs": true,
