{
  "name": "pf",
  "note": "CMS Phase-2 particle flow (event-display NanoAOD, NANO:@EVD): PF candidates (particleFlow, which ends with the TICL PF candidates, one per TICL candidate) with their track, TICL candidate and PF clusters (from the PF block elements), PUPPI weights; PF clusters of ECAL, HCAL barrel, HF and HO with their hits (fractions as weights) and, for ECAL and HCAL, the truth associations written in step3 (AdaptiveNominal, TruthToReco; HF and HO have no associator, truth-graph.md gap 15). Simulated energy per particle in the barrel and forward calorimeter hits (the hit index's Calo channel) as facts. PF candidates are drawn as helices from their vertex to their ECAL entrance; a charged candidate without one (a soft track that curls up before the ECAL, or a TICL candidate) ends at its track's outermost state, and the rest (neutral TICL candidates) at the calorimeter surface, unticked and filtered to what PUPPI kept; preset 'What PUPPI removed' shows the rest. PF clusters use the raw energy (HCAL correctedEnergy is unset in Phase 2).",
  "internal": ["PFCandidateClustersECAL", "PFCandidateClustersHCAL", "PFCandidateClustersHF", "PFCandidateClustersHO",
               "PFClusterECALHits", "PFClusterHCALHits", "PFClusterHFHits", "PFClusterHOHits",
               "TruthEcalHits", "TruthHBHEHits", "TruthHFHits", "TruthHOHits",
               "particleFlowClusterECALToTruth", "particleFlowClusterECALFromTruth",
               "particleFlowClusterHCALToTruth", "particleFlowClusterHCALFromTruth"],
  "relations": [
    {"name": "pfTrack", "kind": "index", "from": "PFCandidates", "to": "Tracks", "index": "PFCandidates.trackIdx"},
    {"name": "pfGsfTrack", "kind": "index", "from": "PFCandidates", "to": "GsfTracks", "index": "PFCandidates.gsfTrackIdx"},
    {"name": "pfTicl", "kind": "index", "from": "PFCandidates", "to": "TICLCandidates", "index": "PFCandidates.ticlCandidateIdx"},
    {"name": "pfClustersECAL", "kind": "links", "from": "PFCandidates", "to": "PFClustersECAL", "table": "PFCandidateClustersECAL",
     "fromIndex": "PFCandidateClustersECAL.candIdx", "toIndex": "PFCandidateClustersECAL.clusterIdx"},
    {"name": "pfClustersHCAL", "kind": "links", "from": "PFCandidates", "to": "PFClustersHCAL", "table": "PFCandidateClustersHCAL",
     "fromIndex": "PFCandidateClustersHCAL.candIdx", "toIndex": "PFCandidateClustersHCAL.clusterIdx"},
    {"name": "pfClustersHF", "kind": "links", "from": "PFCandidates", "to": "PFClustersHF", "table": "PFCandidateClustersHF",
     "fromIndex": "PFCandidateClustersHF.candIdx", "toIndex": "PFCandidateClustersHF.clusterIdx"},
    {"name": "pfClustersHO", "kind": "links", "from": "PFCandidates", "to": "PFClustersHO", "table": "PFCandidateClustersHO",
     "fromIndex": "PFCandidateClustersHO.candIdx", "toIndex": "PFCandidateClustersHO.clusterIdx"},
    {"name": "pfClusterHitsECAL", "kind": "links", "from": "PFClustersECAL", "to": "EcalHits", "table": "PFClusterECALHits",
     "fromIndex": "PFClusterECALHits.clusterIdx", "toIndex": "PFClusterECALHits.hitIdx", "weights": ["PFClusterECALHits.fraction"]},
    {"name": "pfClusterHitsHCAL", "kind": "links", "from": "PFClustersHCAL", "to": "HBHEHits", "table": "PFClusterHCALHits",
     "fromIndex": "PFClusterHCALHits.clusterIdx", "toIndex": "PFClusterHCALHits.hitIdx", "weights": ["PFClusterHCALHits.fraction"]},
    {"name": "pfClusterHitsHF", "kind": "links", "from": "PFClustersHF", "to": "HFHits", "table": "PFClusterHFHits",
     "fromIndex": "PFClusterHFHits.clusterIdx", "toIndex": "PFClusterHFHits.hitIdx", "weights": ["PFClusterHFHits.fraction"]},
    {"name": "pfClusterHitsHO", "kind": "links", "from": "PFClustersHO", "to": "HOHits", "table": "PFClusterHOHits",
     "fromIndex": "PFClusterHOHits.clusterIdx", "toIndex": "PFClusterHOHits.hitIdx", "weights": ["PFClusterHOHits.fraction"]},
    {"name": "pfClusterECALTruth", "kind": "links", "from": "PFClustersECAL", "to": "TruthParticles", "table": "particleFlowClusterECALToTruth",
     "fromIndex": "particleFlowClusterECALToTruth.recoIdx", "toIndex": "particleFlowClusterECALToTruth.truthIdx",
     "weights": ["particleFlowClusterECALToTruth.sharedEnergy", "particleFlowClusterECALToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"},
     "match": {"measure": "energy", "in": "ECAL", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["energy"], "good": 0.5}},
    {"name": "truthPFClustersECAL", "kind": "links", "from": "TruthParticles", "to": "PFClustersECAL", "table": "particleFlowClusterECALFromTruth",
     "fromIndex": "particleFlowClusterECALFromTruth.truthIdx", "toIndex": "particleFlowClusterECALFromTruth.recoIdx",
     "weights": ["particleFlowClusterECALFromTruth.sharedFraction", "particleFlowClusterECALFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"},
     "match": {"measure": "energy", "in": "ECAL", "completeness": {"weight": "sharedFraction"}}},
    {"name": "pfClusterHCALTruth", "kind": "links", "from": "PFClustersHCAL", "to": "TruthParticles", "table": "particleFlowClusterHCALToTruth",
     "fromIndex": "particleFlowClusterHCALToTruth.recoIdx", "toIndex": "particleFlowClusterHCALToTruth.truthIdx",
     "weights": ["particleFlowClusterHCALToTruth.sharedEnergy", "particleFlowClusterHCALToTruth.score"],
     "association": true, "best": {"weight": "score", "order": "min"},
     "match": {"measure": "energy", "in": "HCAL", "target": "caloBoundary", "shared": "sharedEnergy", "over": ["energy"], "good": 0.5}},
    {"name": "truthPFClustersHCAL", "kind": "links", "from": "TruthParticles", "to": "PFClustersHCAL", "table": "particleFlowClusterHCALFromTruth",
     "fromIndex": "particleFlowClusterHCALFromTruth.truthIdx", "toIndex": "particleFlowClusterHCALFromTruth.recoIdx",
     "weights": ["particleFlowClusterHCALFromTruth.sharedFraction", "particleFlowClusterHCALFromTruth.score"],
     "association": true, "best": {"weight": "sharedFraction", "order": "max"},
     "match": {"measure": "energy", "in": "HCAL", "completeness": {"weight": "sharedFraction"}}},
    {"name": "truthHitsEcal", "kind": "links", "from": "TruthParticles", "to": "EcalHits", "table": "TruthEcalHits",
     "fromIndex": "TruthEcalHits.particleIdx", "toIndex": "TruthEcalHits.hitIdx", "weights": ["TruthEcalHits.simEnergy"],
     "association": true, "best": {"weight": "simEnergy", "order": "max"}, "fact": {"in": "ECAL"}},
    {"name": "truthHitsHBHE", "kind": "links", "from": "TruthParticles", "to": "HBHEHits", "table": "TruthHBHEHits",
     "fromIndex": "TruthHBHEHits.particleIdx", "toIndex": "TruthHBHEHits.hitIdx", "weights": ["TruthHBHEHits.simEnergy"],
     "association": true, "best": {"weight": "simEnergy", "order": "max"}, "fact": {"in": "HCAL"}},
    {"name": "truthHitsHO", "kind": "links", "from": "TruthParticles", "to": "HOHits", "table": "TruthHOHits",
     "fromIndex": "TruthHOHits.particleIdx", "toIndex": "TruthHOHits.hitIdx", "weights": ["TruthHOHits.simEnergy"],
     "association": true, "best": {"weight": "simEnergy", "order": "max"}, "fact": {"in": "HO"}},
    {"name": "truthHitsHF", "kind": "links", "from": "TruthParticles", "to": "HFHits", "table": "TruthHFHits",
     "fromIndex": "TruthHFHits.particleIdx", "toIndex": "TruthHFHits.hitIdx", "weights": ["TruthHFHits.simEnergy"],
     "association": true, "best": {"weight": "simEnergy", "order": "max"}, "fact": {"in": "HF"}}
  ],
  "derive": [
    {"table": "PFCandidates", "missing": true, "gather": [{"relation": "pfTrack", "columns": {"endX": "outerX", "endY": "outerY", "endZ": "outerZ"}}]}
  ],
  "kinds": {
    "pfCandidate": {"label": "PF candidates", "domain": "Physics", "repr": "helix", "visible": false,
                    "colourBy": {"category": "pdgId", "abs": true, "names": [["211", "charged hadron"], ["22", "photon"], ["130", "neutral hadron"], ["11", "electron"], ["13", "muon"], ["1", "HF hadron"], ["2", "HF EM"]]},
                    "cut": {"group": "PF candidate pT", "label": "PF candidate pT", "unit": "GeV", "default": 0.0},
                    "truthGap": {"reason": "no PF-candidate associator in CMSSW", "gap": 20}},
    "pfCluster": {"label": "PF clusters", "domain": "Calo", "repr": "markers", "palette": "cool", "visible": true,
                  "cut": {"group": "PF cluster energy", "label": "PF cluster energy", "unit": "GeV", "default": 1.0}}
  },
  "display": [
    {"table": "PFCandidates", "kind": "pfCandidate", "label": "PF candidates", "position": ["vx", "vy", "vz"],
     "momentum": ["px", "py", "pz"], "charge": "charge", "end": ["endX", "endY", "endZ"], "length": {"to": {"r": 129, "z": 320}},
     "size": null, "time": "time", "cut": {"column": "pt"}, "filter": "puppiWeight > 0",
     "describe": {"columns": ["pdgId", "pt"], "names": {"pdgId": {"211": "π⁺", "-211": "π⁻", "22": "γ", "130": "h⁰", "11": "e⁻", "-11": "e⁺", "13": "μ⁻", "-13": "μ⁺", "1": "HF had", "2": "HF EM"}}},
     "inspect": ["pt", "eta", "phi", "energy", "ecalEnergy", "hcalEnergy", "puppiWeight", "time"]},
    {"table": "PFClustersECAL", "kind": "pfCluster", "label": "ECAL", "position": ["x", "y", "z"], "colour": "energy", "size": null,
     "time": "time", "cut": {"column": "energy"}, "describe": {"columns": ["energy"]}, "inspect": ["energy", "eta", "phi", "nHits", "time"]},
    {"table": "PFClustersHCAL", "kind": "pfCluster", "label": "HCAL barrel", "position": ["x", "y", "z"], "colour": "energy", "size": null,
     "time": "time", "cut": {"column": "energy"}, "describe": {"columns": ["energy"]}, "inspect": ["energy", "eta", "phi", "nHits", "depth"]},
    {"table": "PFClustersHO", "kind": "pfCluster", "label": "HCAL outer", "position": ["x", "y", "z"], "colour": "energy", "size": null,
     "visible": false, "cut": {"column": "energy"}, "describe": {"columns": ["energy"]}, "truthGap": {"reason": "no PF-cluster associator for HF and HO is configured in CMSSW", "gap": 15}},
    {"table": "PFClustersHF", "kind": "pfCluster", "label": "HCAL forward", "position": ["x", "y", "z"], "colour": "energy", "size": null,
     "visible": false, "views": ["3d", "side", "rz"], "cut": {"column": "energy"}, "describe": {"columns": ["energy", "layer"], "names": {"layer": {"11": "EM", "12": "HAD"}}}, "truthGap": {"reason": "no PF-cluster associator for HF and HO is configured in CMSSW", "gap": 15}}
  ],
  "presets": [
    {"name": "What PUPPI removed", "filters": {"PFCandidates": "puppiWeight == 0"}}
  ]
}
