{
  "name": "phase2",
  "note": "Ember's own NanoAOD of a Phase-2 reconstruction file (ember FILE.root: embertools/cmsrun.py), and NANO:@HGCAL files (DPGAnalysis/HGCalNanoAOD, whose tables it shares): HGCal rechits (PhysicsTools/TruthInfo table 'rechits': positions from TICLGeom; cell half widths from the DetId: the 0.403 / 0.604 cm apothems of high- and low-density silicon, r dphi / 2 of the 288 scintillator tiles), layer clusters, tracksters with their layer clusters, TICL candidates with their tracksters and tracks (legacy collections: offline RECO stores no SoA collections, and the release has no SoA table producers); ECAL barrel and HCAL PF rechits (TruthInfo table 'pfrechits', split here by the DetId's subdetector: Phase 2 has no ECAL endcap, preshower or HCAL endcap) drawn as towers, EB 0.0174 x 1 degree, HCAL from the DetId's ieta and depth (geometry sweep of D104), EB and HO showing energy as length; PF clusters, superclusters, tracks, physics objects (reco.json, nano.json). A cluster's hits are found by DetId (when the release writes cluster-hits tables). Truth (truth.json): the TruthInfo tables of the truth graph, when the release writes them and the input has the graph. Trackster axes are read as (x, z, y) because HGCalNanoAOD swaps eVector0_y/z.",
  "include": ["nano", "reco", "muonsystem", "truth"],
  "omit": ["rechits.rechit_radius"],
  "internal": ["linkedTracksters", "TICLCandidatesExtra", "TICLCandidatesTrackIdxs", "TICLCandidatesGsfTrackIdxs", "HGCalLayerClustersHits", "SuperClusterHGCalHits", "ticlTrackstersCLUE3DHighvertices", "ticlTrackstersCLUEsteringvertices", "ticlTracksterLinksvertices", "ticlTracksterLinksSuperclusteringDNNvertices", "ticlTracksterInterpretationsvertices", "ticlCandidatevertices"],
  "derive": [
    {"table": "rechits", "cell": "hgcal", "detId": "rechit_ID", "position": ["rechit_x", "rechit_y", "rechit_z"]},
    {"table": "pfrechits", "bits": {"det": ["rechit_ID", 28, 4], "subdet": ["rechit_ID", 25, 3]}},
    {"table": "pfrechits", "split": {"EBHits": [["det", "==", 3], ["subdet", "==", 1]], "HBHits": [["det", "==", 4], ["subdet", "==", 1]], "HOHits": [["det", "==", 4], ["subdet", "==", 3]], "HFHits": [["det", "==", 4], ["subdet", "==", 4]]}},
    {"table": "HBHits", "cell": "hcal", "geometry": "phase2", "detId": "rechit_ID", "position": ["rechit_x", "rechit_y", "rechit_z"]},
    {"table": "HOHits", "cell": "hcal", "geometry": "phase2", "detId": "rechit_ID", "position": ["rechit_x", "rechit_y", "rechit_z"]},
    {"table": "HFHits", "cell": "hcal", "geometry": "phase2", "detId": "rechit_ID", "position": ["rechit_x", "rechit_y", "rechit_z"]},
    {"table": "RecHitHBHE", "bits": {"subdet": ["detId", 25, 3]}},
    {"table": "RecHitHBHE", "split": {"RecHitHB": [["subdet", "==", 1]]}},
    {"table": "RecHitHB", "cell": "hcal", "geometry": "phase2", "detId": "detId", "position": ["x", "y", "z"]},
    {"table": "RecHitHO", "cell": "hcal", "geometry": "phase2", "detId": "detId", "position": ["x", "y", "z"]},
    {"table": "RecHitHF", "cell": "hcal", "geometry": "phase2", "detId": "detId", "position": ["x", "y", "z"]},
    {"table": "TICLCandidates", "gather": [{"relation": "candidateTrackster", "columns": {"x": "barycenter_x", "y": "barycenter_y", "z": "barycenter_z", "axis_x": "eVector0_x", "axis_y": "eVector0_z", "axis_z": "eVector0_y", "ev1": "EV1", "ev2": "EV2", "ev3": "EV3"}}, {"relation": "candidateOwnTrackster", "columns": {"x": "barycenter_x", "y": "barycenter_y", "z": "barycenter_z", "axis_x": "eVector0_x", "axis_y": "eVector0_z", "axis_z": "eVector0_y", "ev1": "EV1", "ev2": "EV2", "ev3": "EV3"}}, {"relation": "candidateTrack", "columns": {"x": "hgcal_x", "y": "hgcal_y", "z": "hgcal_z"}}]}
  ],
  "relations": [
    {"name": "clue3dLCs", "kind": "counts", "from": "ticlTrackstersCLUE3DHigh", "to": "HGCalLayerClusters", "counts": "ticlTrackstersCLUE3DHigh.nticlTrackstersCLUE3DHighvertices", "indices": "ticlTrackstersCLUE3DHighvertices.vertices", "weights": ["ticlTrackstersCLUE3DHighvertices.vertex_mult"]},
    {"name": "clusteringLCs", "kind": "counts", "from": "ticlTrackstersCLUEstering", "to": "HGCalLayerClusters", "counts": "ticlTrackstersCLUEstering.nticlTrackstersCLUEsteringvertices", "indices": "ticlTrackstersCLUEsteringvertices.vertices", "weights": ["ticlTrackstersCLUEsteringvertices.vertex_mult"]},
    {"name": "linksLCs", "kind": "counts", "from": "ticlTracksterLinks", "to": "HGCalLayerClusters", "counts": "ticlTracksterLinks.nticlTracksterLinksvertices", "indices": "ticlTracksterLinksvertices.vertices", "weights": ["ticlTracksterLinksvertices.vertex_mult"]},
    {"name": "superclusterLCs", "kind": "counts", "from": "ticlTracksterLinksSuperclusteringDNN", "to": "HGCalLayerClusters", "counts": "ticlTracksterLinksSuperclusteringDNN.nticlTracksterLinksSuperclusteringDNNvertices", "indices": "ticlTracksterLinksSuperclusteringDNNvertices.vertices", "weights": ["ticlTracksterLinksSuperclusteringDNNvertices.vertex_mult"]},
    {"name": "interpretationLCs", "kind": "counts", "from": "ticlTracksterInterpretations", "to": "HGCalLayerClusters", "counts": "ticlTracksterInterpretations.nticlTracksterInterpretationsvertices", "indices": "ticlTracksterInterpretationsvertices.vertices", "weights": ["ticlTracksterInterpretationsvertices.vertex_mult"]},
    {"name": "ownTracksterLCs", "kind": "counts", "from": "ticlCandidate", "to": "HGCalLayerClusters", "counts": "ticlCandidate.nticlCandidatevertices", "indices": "ticlCandidatevertices.vertices", "weights": ["ticlCandidatevertices.vertex_mult"]},
    {"name": "candidateTrackster", "kind": "counts", "from": "TICLCandidates", "to": "ticlTracksterInterpretations", "counts": "TICLCandidates.nTICLCandidatesExtra", "indices": "TICLCandidatesExtra.tracksterIndex"},
    {"name": "candidateOwnTrackster", "kind": "counts", "from": "TICLCandidates", "to": "ticlCandidate", "counts": "TICLCandidates.nTICLCandidatesExtra", "indices": "TICLCandidatesExtra.tracksterIndex"},
    {"name": "candidateLinkedTracksters", "kind": "counts", "from": "TICLCandidates", "to": "ticlTracksterLinks", "counts": "TICLCandidates.nLinkedTracksters", "indices": "linkedTracksters.tracksterIndex"},
    {"name": "candidateTrack", "kind": "index", "from": "TICLCandidates", "to": "GeneralTrack", "index": "TICLCandidates.trackIdx"},
    {"name": "layerClusterHits", "kind": "counts", "from": "HGCalLayerClusters", "to": "rechits", "counts": "HGCalLayerClusters.nHGCalLayerClustersHits", "indices": "HGCalLayerClustersHits.detId", "toKey": "rechits.rechit_ID", "weights": ["HGCalLayerClustersHits.fraction"]},
    {"name": "superClusterHGCalHits", "kind": "counts", "from": "SuperClusterHGCal", "to": "rechits", "counts": "SuperClusterHGCal.nSuperClusterHGCalHits", "indices": "SuperClusterHGCalHits.detId", "toKey": "rechits.rechit_ID", "weights": ["SuperClusterHGCalHits.fraction"]},
    {"name": "pfTicl", "kind": "index", "from": "PFCandidates", "to": "TICLCandidates", "index": "PFCandidates.ticlCandidateIdx", "optional": true},
    {"name": "candidateLCs", "kind": "compose", "from": "TICLCandidates", "to": "HGCalLayerClusters", "via": ["candidateTrackster", "interpretationLCs"]},
    {"name": "candidateOwnLCs", "kind": "compose", "from": "TICLCandidates", "to": "HGCalLayerClusters", "via": ["candidateOwnTrackster", "ownTracksterLCs"]}
  ],
  "cuts": {"TICLCandidates": [{"defined": "x"}]},
  "stages": ["trackster", "linkedTrackster", "interpretation", "candidateTrackster", "candidate"],
  "kinds": {
    "rechit": {"label": "Hits", "domain": "HGCal", "repr": "cells", "palette": "heat", "visible": true, "cut": {"group": "Hit energy", "unit": "GeV", "default": 0.035}},
    "layerCluster": {"label": "Layer clusters", "domain": "HGCal", "repr": "markers", "palette": "cool", "visible": true, "cut": {"group": "Layer cluster energy", "unit": "GeV", "default": 0.0}},
