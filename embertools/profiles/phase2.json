    "candidate": {"label": "Candidates", "domain": "HGCal", "repr": "ellipsoids", "shape": "core", "visible": true, "colourBy": {"category": "pdgID", "abs": true, "names": {"22": "photon", "11": "electron", "13": "muon", "211": "charged hadron", "130": "neutral hadron", "111": "neutral pion"}}}
  },
  "display": [
    {"table": "rechits", "kind": "rechit", "label": "HGCal", "position": ["rechit_x", "rechit_y", "rechit_z"], "time": "rechit_time", "colour": "rechit_energy", "size": "halfWidth", "cut": {"column": "rechit_energy"}, "inspect": ["rechit_energy", "rechit_time", "rechit_ID"]},
    {"table": "HGCalLayerClusters", "kind": "layerCluster", "label": "Merged", "position": ["position_x", "position_y", "position_z"], "time": "time", "colour": "energy", "colourBy": "stage", "size": null, "cut": {"column": "energy"}, "describe": {"columns": ["energy"]}},
