    {"name": "jetCHSConstituents", "kind": "links", "from": "JetCHS", "to": "PFCandidates", "table": "JetCHSPFCands", "fromIndex": "JetCHSPFCands.jetIdx", "toIndex": "JetCHSPFCands.pfCandIdx"},
    {"name": "tauConstituents", "kind": "links", "from": "Tau", "to": "PFCandidates", "table": "TauPFCands", "fromIndex": "TauPFCands.tauIdx", "toIndex": "TauPFCands.pfCandIdx"}
  ],
  "kinds": {
    "caloHit": {"label": "Calorimeter hits", "domain": "Calo", "repr": "cells", "palette": "heat", "colour": "rechit_energy", "size": null, "time": "rechit_time", "visible": true, "describe": {"columns": ["rechit_energy"]}, "inspect": ["rechit_energy", "rechit_time", "rechit_eta", "rechit_phi", "rechit_depth", "rechit_ID"]},
    "pfCluster": {"label": "PF clusters", "domain": "Calo", "repr": "markers", "palette": "cool", "visible": true, "colour": "energy", "size": null, "cut": {"group": "PF cluster energy", "label": "PF cluster energy", "column": "energy", "unit": "GeV", "default": 1.0}, "describe": {"columns": ["energy"]}, "inspect": ["energy", "nHits"]},
    "superCluster": {"label": "Superclusters", "domain": "Calo", "repr": "markers", "palette": "cool", "visible": false, "colour": "energy", "size": null, "describe": {"columns": ["energy"]}, "inspect": ["energy", "rawEnergy", "eta", "phi", "etaWidth", "phiWidth", "nClusters"]},
    "track": {"label": "Tracks", "domain": "Tracker", "repr": "helix", "visible": true, "colour": "pt", "size": null, "cut": {"group": "Track pT", "label": "track pT", "column": "pt", "unit": "GeV", "default": 1.0}, "describe": {"columns": ["pt", "eta"]}, "inspect": ["pt", "eta", "phi", "charge", "nhits", "highPurity"]},
    "beamSpot": {"label": "Beam spot", "domain": "Tracker", "repr": "markers", "visible": false, "size": null},
    "gsfTrack": {"label": "GSF tracks", "domain": "Tracker", "repr": "helix", "visible": true, "onSelection": true, "colour": "pt", "size": null, "describe": {"columns": ["pt", "eta"]}, "inspect": ["pt", "eta", "phi", "charge", "nhits"], "truthGap": {"reason": "the truth graph has no GSF-track trait yet (a GSF track is a reco::Track, so the track associator could take one)", "gap": 23}},
    "trackHit": {"label": "Track hits", "domain": "Tracker", "repr": "markers", "visible": true, "onSelection": true, "size": null, "colourBy": {"category": "subdet", "names": [["1", "pixel barrel"], ["2", "pixel endcap"], ["5", "TOB (Phase 2: outer barrel)"], ["6", "TEC"], ["4", "TID (Phase 2: outer endcap)"], ["3", "TIB"]]}, "describe": {"columns": ["subdet", "layer"], "names": {"subdet": {"1": "PXB", "2": "PXF", "3": "TIB", "4": "TID", "5": "TOB", "6": "TEC"}}}, "inspect": ["subdet", "layer", "detId"]},
    "pfCandidate": {"label": "PF candidates", "domain": "Physics", "repr": "helix", "visible": false, "size": null, "colourBy": {"category": "pdgId", "abs": true, "names": [["211", "charged hadron"], ["22", "photon"], ["130", "neutral hadron"], ["11", "electron"], ["13", "muon"], ["1", "HF hadron"], ["2", "HF EM"]]}, "cut": {"group": "PF candidate pT", "label": "PF candidate pT", "unit": "GeV", "default": 0.0}, "truthGap": {"reason": "the truth graph has no PF-candidate associator", "gap": 20}}
  },
  "display": [
    {"table": "GeneralTrack", "kind": "track", "label": "General tracks", "position": ["vx", "vy", "vz"], "momentum": ["px", "py", "pz"], "charge": "charge", "end": ["outerX", "outerY", "outerZ"], "filter": "highPurity == 1 && vertex < 1"},
