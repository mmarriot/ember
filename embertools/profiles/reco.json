{
  "name": "reco",
  "note": "What Ember's own NanoAOD of a reconstruction file has in Phase 2 and in Run 3 alike (phase2.json and run3.json include it): general tracks as helices from their reference point to their outermost hit (high purity by default), the beam spot, PF clusters (ECAL, preshower, HCAL, HF, HO) and superclusters (ECAL barrel and endcap) as markers, and the kinds of the calorimeter hits that phase2.json and run3.json split by subdetector. A cluster's hits are found by DetId in the hit tables (relations of kind counts with toKey): the cluster-hits tables of the CMSSW branch mmarriot:nanoaod-cluster-hits, when the release has them; the hits below the PF thresholds are not written, and their links are dropped.",
  "internal": ["PFClusterECALHits", "PFClusterPSHits", "PFClusterHCALHits", "PFClusterHFHits", "PFClusterHOHits", "SuperClusterEBHits", "SuperClusterEEHits"],
  "derive": [
    {"table": "GeneralTrack", "momentum": ["pt", "eta", "phi"]},
    {"table": "GsfTrack", "momentum": ["pt", "eta", "phi"]},
    {"table": "PFCandidates", "momentum": ["pt", "eta", "phi"]},
    {"table": "PFCandidates", "missing": true, "gather": [{"relation": "pfTrack", "columns": {"endX": "outerX", "endY": "outerY", "endZ": "outerZ"}}]}
  ],
  "relations": [
    {"name": "pfClusterECALHitsEB", "kind": "counts", "from": "PFClusterECAL", "to": "EBHits", "counts": "PFClusterECAL.nPFClusterECALHits", "indices": "PFClusterECALHits.detId", "toKey": "EBHits.rechit_ID", "weights": ["PFClusterECALHits.fraction"]},
    {"name": "pfClusterECALHitsEE", "kind": "counts", "from": "PFClusterECAL", "to": "EEHits", "counts": "PFClusterECAL.nPFClusterECALHits", "indices": "PFClusterECALHits.detId", "toKey": "EEHits.rechit_ID", "weights": ["PFClusterECALHits.fraction"]},
    {"name": "pfClusterPSHits", "kind": "counts", "from": "PFClusterPS", "to": "ESHits", "counts": "PFClusterPS.nPFClusterPSHits", "indices": "PFClusterPSHits.detId", "toKey": "ESHits.rechit_ID", "weights": ["PFClusterPSHits.fraction"]},
    {"name": "pfClusterHCALHitsHB", "kind": "counts", "from": "PFClusterHCAL", "to": "HBHits", "counts": "PFClusterHCAL.nPFClusterHCALHits", "indices": "PFClusterHCALHits.detId", "toKey": "HBHits.rechit_ID", "weights": ["PFClusterHCALHits.fraction"]},
    {"name": "pfClusterHCALHitsHE", "kind": "counts", "from": "PFClusterHCAL", "to": "HEHits", "counts": "PFClusterHCAL.nPFClusterHCALHits", "indices": "PFClusterHCALHits.detId", "toKey": "HEHits.rechit_ID", "weights": ["PFClusterHCALHits.fraction"]},
    {"name": "pfClusterHFHits", "kind": "counts", "from": "PFClusterHF", "to": "HFHits", "counts": "PFClusterHF.nPFClusterHFHits", "indices": "PFClusterHFHits.detId", "toKey": "HFHits.rechit_ID", "weights": ["PFClusterHFHits.fraction"]},
    {"name": "pfClusterHOHits", "kind": "counts", "from": "PFClusterHO", "to": "HOHits", "counts": "PFClusterHO.nPFClusterHOHits", "indices": "PFClusterHOHits.detId", "toKey": "HOHits.rechit_ID", "weights": ["PFClusterHOHits.fraction"]},
    {"name": "superClusterEBHits", "kind": "counts", "from": "SuperClusterEB", "to": "EBHits", "counts": "SuperClusterEB.nSuperClusterEBHits", "indices": "SuperClusterEBHits.detId", "toKey": "EBHits.rechit_ID", "weights": ["SuperClusterEBHits.fraction"]},
    {"name": "superClusterEEHits", "kind": "counts", "from": "SuperClusterEE", "to": "EEHits", "counts": "SuperClusterEE.nSuperClusterEEHits", "indices": "SuperClusterEEHits.detId", "toKey": "EEHits.rechit_ID", "weights": ["SuperClusterEEHits.fraction"]},
    {"name": "pfTrack", "kind": "index", "from": "PFCandidates", "to": "GeneralTrack", "index": "PFCandidates.trackIdx"},
    {"name": "pfGsfTrack", "kind": "index", "from": "PFCandidates", "to": "GsfTrack", "index": "PFCandidates.gsfTrackIdx"},
    {"name": "pfMuon", "kind": "index", "from": "PFCandidates", "to": "Muon", "index": "PFCandidates.muonIdx", "optional": true},
    {"name": "pfElectron", "kind": "index", "from": "PFCandidates", "to": "Electron", "index": "PFCandidates.electronIdx", "optional": true},
    {"name": "pfPhoton", "kind": "index", "from": "PFCandidates", "to": "Photon", "index": "PFCandidates.photonIdx", "optional": true},
    {"name": "electronGsfTrack", "kind": "index", "from": "Electron", "to": "GsfTrack", "index": "Electron.gsfTrackIdx", "optional": true},
    {"name": "electronTrack", "kind": "index", "from": "Electron", "to": "GeneralTrack", "index": "Electron.trackIdx", "optional": true},
    {"name": "electronSuperClusterEB", "kind": "index", "from": "Electron", "to": "SuperClusterEB", "index": "Electron.superClusterEBIdx", "optional": true},
    {"name": "electronSuperClusterEE", "kind": "index", "from": "Electron", "to": "SuperClusterEE", "index": "Electron.superClusterEEIdx", "optional": true},
    {"name": "electronHGCGsfTrack", "kind": "index", "from": "ElectronHGC", "to": "GsfTrack", "index": "ElectronHGC.gsfTrackIdx", "optional": true},
    {"name": "electronHGCTrack", "kind": "index", "from": "ElectronHGC", "to": "GeneralTrack", "index": "ElectronHGC.trackIdx", "optional": true},
    {"name": "electronHGCSuperCluster", "kind": "index", "from": "ElectronHGC", "to": "SuperClusterHGCal", "index": "ElectronHGC.superClusterIdx", "optional": true},
    {"name": "photonSuperClusterEB", "kind": "index", "from": "Photon", "to": "SuperClusterEB", "index": "Photon.superClusterEBIdx", "optional": true},
    {"name": "photonSuperClusterEE", "kind": "index", "from": "Photon", "to": "SuperClusterEE", "index": "Photon.superClusterEEIdx", "optional": true},
    {"name": "photonHGCSuperCluster", "kind": "index", "from": "PhotonHGC", "to": "SuperClusterHGCal", "index": "PhotonHGC.superClusterIdx", "optional": true},
    {"name": "muonTrack", "kind": "index", "from": "Muon", "to": "GeneralTrack", "index": "Muon.trackIdx", "optional": true},
    {"name": "tauLeadCand", "kind": "index", "from": "Tau", "to": "PFCandidates", "index": "Tau.leadCandIdx", "optional": true}
  ],
  "kinds": {
    "caloHit": {"label": "Hits", "domain": "Calo", "repr": "cells", "palette": "heat", "colour": "rechit_energy", "size": null, "time": "rechit_time", "visible": true, "describe": {"columns": ["rechit_energy"]}, "inspect": ["rechit_energy", "rechit_time", "rechit_eta", "rechit_phi", "rechit_depth", "rechit_ID"]},
    "pfCluster": {"label": "PF clusters", "domain": "Calo", "repr": "markers", "palette": "cool", "visible": true, "colour": "energy", "size": null, "cut": {"group": "PF cluster energy", "label": "PF cluster energy", "column": "energy", "unit": "GeV", "default": 1.0}, "describe": {"columns": ["energy"]}, "inspect": ["energy", "nHits"]},
    "superCluster": {"label": "Superclusters", "domain": "Calo", "repr": "markers", "palette": "cool", "visible": false, "colour": "energy", "size": null, "describe": {"columns": ["energy"]}, "inspect": ["energy", "rawEnergy", "eta", "phi", "etaWidth", "phiWidth", "nClusters"]},
    "track": {"label": "Tracks", "domain": "Tracker", "repr": "helix", "visible": true, "colour": "pt", "size": null, "cut": {"group": "Track pT", "label": "track pT", "column": "pt", "unit": "GeV", "default": 1.0}, "describe": {"columns": ["pt", "eta"]}, "inspect": ["pt", "eta", "phi", "charge", "nhits", "highPurity"]},
    "beamSpot": {"label": "Beam spot", "domain": "Tracker", "repr": "markers", "visible": false, "size": null},
    "gsfTrack": {"label": "GSF tracks", "domain": "Tracker", "repr": "helix", "visible": true, "onSelection": true, "colour": "pt", "size": null, "describe": {"columns": ["pt", "eta"]}, "inspect": ["pt", "eta", "phi", "charge", "nhits"], "truthGap": {"reason": "no GSF-track associator in CMSSW (the track associator reads reco::Track collections only)", "gap": 23}},
    "pfCandidate": {"label": "PF candidates", "domain": "Physics", "repr": "helix", "visible": false, "size": null, "colourBy": {"category": "pdgId", "abs": true, "names": [["211", "charged hadron"], ["22", "photon"], ["130", "neutral hadron"], ["11", "electron"], ["13", "muon"], ["1", "HF hadron"], ["2", "HF EM"]]}, "cut": {"group": "PF candidate pT", "label": "PF candidate pT", "unit": "GeV", "default": 0.0}, "truthGap": {"reason": "no PF-candidate associator in CMSSW", "gap": 20}}
  },
  "display": [
    {"table": "GeneralTrack", "kind": "track", "label": "General tracks", "position": ["vx", "vy", "vz"], "momentum": ["px", "py", "pz"], "charge": "charge", "end": ["outerX", "outerY", "outerZ"], "filter": "highPurity == 1"},
    {"table": "OfflineBeamSpot", "kind": "beamSpot", "label": "Beam spot", "position": ["x", "y", "z"]},
    {"table": "PFClusterECAL", "kind": "pfCluster", "label": "ECAL", "position": ["x", "y", "z"]},
    {"table": "PFClusterPS", "kind": "pfCluster", "label": "Preshower", "position": ["x", "y", "z"], "visible": false, "cut": {"group": "Preshower cluster energy", "label": "preshower cluster energy", "default": 0.0}},
    {"table": "PFClusterHCAL", "kind": "pfCluster", "label": "HCAL", "position": ["x", "y", "z"]},
    {"table": "PFClusterHO", "kind": "pfCluster", "label": "HCAL outer", "position": ["x", "y", "z"], "visible": false, "truthGap": {"reason": "no PF-cluster associator for HF and HO is configured in CMSSW", "gap": 15}},
    {"table": "PFClusterHF", "kind": "pfCluster", "label": "HCAL forward", "position": ["x", "y", "z"], "visible": false, "truthGap": {"reason": "no PF-cluster associator for HF and HO is configured in CMSSW", "gap": 15}, "views": ["3d", "side", "rz"]},
    {"table": "SuperClusterEB", "kind": "superCluster", "label": "ECAL barrel", "position": ["x", "y", "z"]},
    {"table": "SuperClusterEE", "kind": "superCluster", "label": "ECAL endcap", "position": ["x", "y", "z"]},
    {"table": "GsfTrack", "kind": "gsfTrack", "label": "Of the electrons", "position": ["vx", "vy", "vz"], "momentum": ["px", "py", "pz"], "charge": "charge", "end": ["outerX", "outerY", "outerZ"]},
    {"table": "PFCandidates", "kind": "pfCandidate", "label": "Particle flow", "position": ["vx", "vy", "vz"], "momentum": ["px", "py", "pz"], "charge": "charge", "end": ["endX", "endY", "endZ"], "length": {"to": {"r": 129, "z": 320}}, "time": "time", "cut": {"column": "pt"}, "filter": "puppiWeight > 0", "describe": {"columns": ["pdgId", "pt"], "names": {"pdgId": {"211": "π⁺", "-211": "π⁻", "22": "γ", "130": "h⁰", "11": "e⁻", "-11": "e⁺", "13": "μ⁻", "-13": "μ⁺", "1": "HF had", "2": "HF EM"}}}, "inspect": ["pt", "eta", "phi", "energy", "ecalEnergy", "hcalEnergy", "time"]}
  ],
  "presets": [
    {"name": "Primary vertex", "filters": {"PV": "index == 0"}},
    {"name": "All vertices", "filters": {"PV": ""}, "colour": {"GeneralTrack": "rel:trackVertex"}},
    {"name": "What PUPPI removed", "filters": {"PFCandidates": "puppiWeight == 0"}}
  ],
  "view": {"colourRoot": "pfCandidate"},
  "domains": [{"name": "Tracker", "region": {"rMax": 120, "zMax": 280}, "view": "front", "colourMode": "layers", "minRadius": 15}],
  "field": {"bz": 3.8, "rMax": 295, "zMax": 320}
}
