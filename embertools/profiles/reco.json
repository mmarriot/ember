    {"name": "electronHGCGsfTrack", "kind": "index", "from": "ElectronHGC", "to": "GsfTrack", "index": "ElectronHGC.gsfTrackIdx", "optional": true},
    {"name": "electronHGCTrack", "kind": "index", "from": "ElectronHGC", "to": "GeneralTrack", "index": "ElectronHGC.trackIdx", "optional": true},
    {"name": "electronHGCSuperCluster", "kind": "index", "from": "ElectronHGC", "to": "SuperClusterHGCal", "index": "ElectronHGC.superClusterIdx", "optional": true},
    {"name": "photonSuperClusterEB", "kind": "index", "from": "Photon", "to": "SuperClusterEB", "index": "Photon.superClusterEBIdx", "optional": true},
    {"name": "photonSuperClusterEE", "kind": "index", "from": "Photon", "to": "SuperClusterEE", "index": "Photon.superClusterEEIdx", "optional": true},
    {"name": "photonHGCSuperCluster", "kind": "index", "from": "PhotonHGC", "to": "SuperClusterHGCal", "index": "PhotonHGC.superClusterIdx", "optional": true},
    {"name": "muonTrack", "kind": "index", "from": "Muon", "to": "GeneralTrack", "index": "Muon.trackIdx", "optional": true},
    {"name": "tauLeadCand", "kind": "index", "from": "Tau", "to": "PFCandidates", "index": "Tau.leadCandIdx", "optional": true},
    {"name": "trackHits", "kind": "counts", "from": "GeneralTrack", "to": "GeneralTrackHits", "counts": "GeneralTrack.nGeneralTrackHits"},
    {"name": "gsfTrackHits", "kind": "counts", "from": "GsfTrack", "to": "GsfTrackHits", "counts": "GsfTrack.nGsfTrackHits"},
    {"name": "vertexTracks", "kind": "links", "from": "PV", "to": "GeneralTrack", "table": "PVTracks", "fromIndex": "PVTracks.vertexIdx", "toIndex": "PVTracks.trackIdx", "weights": ["PVTracks.weight"]},
    {"name": "trackVertex", "kind": "links", "from": "GeneralTrack", "to": "PV", "table": "PVTracks", "fromIndex": "PVTracks.trackIdx", "toIndex": "PVTracks.vertexIdx", "weights": ["PVTracks.weight"], "inverseOf": "vertexTracks"},
    {"name": "svTracks", "kind": "links", "from": "SV", "to": "GeneralTrack", "table": "SVTracks", "fromIndex": "SVTracks.vertexIdx", "toIndex": "SVTracks.trackIdx", "weights": ["SVTracks.weight"]},
    {"name": "pfClustersECAL", "kind": "links", "from": "PFCandidates", "to": "PFClusterECAL", "table": "PFCandidateClustersECAL", "fromIndex": "PFCandidateClustersECAL.pfCandIdx", "toIndex": "PFCandidateClustersECAL.clusterIdx"},
    {"name": "pfClustersPS", "kind": "links", "from": "PFCandidates", "to": "PFClusterPS", "table": "PFCandidateClustersPS", "fromIndex": "PFCandidateClustersPS.pfCandIdx", "toIndex": "PFCandidateClustersPS.clusterIdx"},
    {"name": "pfClustersHCAL", "kind": "links", "from": "PFCandidates", "to": "PFClusterHCAL", "table": "PFCandidateClustersHCAL", "fromIndex": "PFCandidateClustersHCAL.pfCandIdx", "toIndex": "PFCandidateClustersHCAL.clusterIdx"},
    {"name": "pfClustersHF", "kind": "links", "from": "PFCandidates", "to": "PFClusterHF", "table": "PFCandidateClustersHF", "fromIndex": "PFCandidateClustersHF.pfCandIdx", "toIndex": "PFCandidateClustersHF.clusterIdx"},
