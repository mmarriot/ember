{
  "name": "mct",
  "note": "HGCal multi-cassette test (P5), cosmic muons. Hits above 3 sigma of noise; events need a hit above 6 sigma in each of layers 25 and 26 (muon candidates). With a per-run channel table (HGCChannel, hgcal-comm NanoTools) hits get their exact cell size and electronics address and the whole readout is drawn as a background; without it the cell size is estimated from the hit spacing.",
  "exclude": ["HGCTriggerDigi", "HGCTypeCodes", "EventTrain", "HGCReadout", "HGCECON", "HGCMCP", "HGCMetaData"],
  "internal": ["HGCDenseIndex"],
  "derive": [
    {"table": "HGCHit", "column": "cellSize", "neighbourDistance": ["x", "y"], "groupBy": "layer", "k": 3, "scale": 0.5},
    {"table": "HGCHit", "lookup": "HGCChannel", "index": "denseIndex",
     "columns": {"cellSize": "cellSize", "fed": "fedId", "econd": "fedReadoutSeq", "channel": "channel", "module": "module",
                 "cassette": "cassette", "moduleU": "modI1", "moduleV": "modI2", "cellU": "chI1", "cellV": "chI2",
                 "isCalib": "iscalib"}}
  ],
  "relations": [
    {"name": "hitDigi", "kind": "index", "from": "HGCHit", "to": "HGCDigi", "index": "HGCHit.denseIndex", "via": "HGCDenseIndex.digiIdx"},
    {"name": "clusterHits", "kind": "index", "from": "HGCLayerClusters", "to": "HGCHit", "index": "HGCHit.clusterIndex"}
  ],
  "cuts": {
    "HGCHit": [["energy/sigmaNoise", ">", 3], ["layer", ">", 0]],
    "HGCDigi": [{"reachedBy": "hitDigi"}],
    "HGCLayerClusters": [["layer", ">", 0]],
    "HGCChannel": [["detid", "!=", 0]]
  },
  "select": [
    {"table": "HGCHit", "where": [["layer", "==", 25], ["energy/sigmaNoise", ">", 6]], "min": 1},
    {"table": "HGCHit", "where": [["layer", "==", 26], ["energy/sigmaNoise", ">", 6]], "min": 1}
  ],
  "display": [
    {"table": "HGCHit", "repr": "cells", "group": "HGCal MCT", "label": "Rechits", "position": ["x", "y", "z"],
     "colour": "nmips", "palette": "heat", "size": "cellSize", "visible": true,
     "cut": {"group": "Rechit energy", "column": "energy", "unit": "GeV", "default": 0.0}},
    {"table": "HGCLayerClusters", "repr": "markers", "group": "HGCal MCT", "label": "Layer clusters",
     "position": ["x", "y", "z"], "colour": "energy", "palette": "cool", "size": null, "visible": true},
    {"table": "HGCChannel", "repr": "cells", "group": "Detector", "label": "Readout channels", "position": ["x", "y", "z"],
     "size": "cellSize", "colourBy": {"category": "module"}, "context": true, "dim": 0.8, "visible": true}
  ],
  "view": {"start": "3d", "minRadius": 25},
  "replay": {"direction": [0, -1, 0]},
  "summaries": [
    {"title": "Energy per layer", "table": "HGCHit", "groupBy": "layer", "value": "nmips", "op": "sum", "unit": "MIP"},
    {"title": "Hits per layer", "table": "HGCHit", "groupBy": "layer", "op": "count"},
    {"title": "Layer clusters per layer", "table": "HGCLayerClusters", "groupBy": "layer", "op": "count"}
  ],
  "runTitle": "{Type} · {Tags}",
  "runFields": ["Type", "Era", "Beam", "Energy", "B", "Start", "End", "Tags", "Comments"]
}
