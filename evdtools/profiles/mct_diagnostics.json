{
  "name": "mct_diagnostics",
  "note": "HGCal multi-cassette test (P5): unusual events, e.g. splats (thousands of channels just above noise for a few consecutive triggers). No event selection: pick events with --events (include neighbours to see before and after). Every hit above 3 sigma of noise is drawn; each hit carries its digi's module, ADC, common mode, ToA and ToT, and all digis are kept for the per-module charts. Positions and cell sizes come from the per-run channel table (HGCChannel, hgcal-comm NanoTools); for files made without it, take it from another file of the same run with --run-tables.",
  "exclude": ["HGCTriggerDigi", "HGCTypeCodes", "EventTrain", "HGCReadout", "HGCMCP", "HGCFED"],
  "internal": ["HGCDenseIndex"],
  "derive": [
    {"table": "HGCHit", "lookup": "HGCChannel", "index": "denseIndex",
     "columns": {"cellSize": "cellSize", "cassette": "cassette", "moduleU": "modI1", "moduleV": "modI2", "cellU": "chI1", "cellV": "chI2"}},
    {"table": "HGCHit", "gather": [{"relation": "hitDigi",
      "columns": {"module": "fedReadoutSeq", "channel": "channel", "adc": "adc", "adcm1": "adcm1", "cm": "cm", "toa": "toa", "tot": "tot"}}]}
  ],
  "relations": [
    {"name": "hitDigi", "kind": "index", "from": "HGCHit", "to": "HGCDigi", "index": "HGCHit.denseIndex", "via": "HGCDenseIndex.digiIdx"},
    {"name": "clusterHits", "kind": "index", "from": "HGCLayerClusters", "to": "HGCHit", "index": "HGCHit.clusterIndex"}
  ],
  "cuts": {
    "HGCHit": [["energy/sigmaNoise", ">", 3], ["layer", ">", 0]],
    "HGCChannel": [["detid", "!=", 0]]
  },
  "replay": {"order": "random"},
  "view": {"start": "front", "minRadius": 25},
  "summaries": [
    {"title": "Hits above 5 sigma per layer", "table": "HGCHit", "groupBy": "layer", "op": "count", "where": "energy / sigmaNoise > 5"},
    {"title": "Hits above 5 sigma per module", "table": "HGCHit", "groupBy": "module", "op": "count", "where": "energy / sigmaNoise > 5"},
    {"title": "Mean common mode per module (all channels)", "table": "HGCDigi", "groupBy": "fedReadoutSeq", "value": "cm", "op": "mean", "unit": "ADC"},
    {"title": "Mean ADC per module (all channels)", "table": "HGCDigi", "groupBy": "fedReadoutSeq", "value": "adc", "op": "mean", "unit": "ADC"}
  ],
  "presets": [
    {"name": "Energy"},
    {"name": "ADC", "colour": {"HGCHit": "adc"}},
    {"name": "Common mode", "colour": {"HGCHit": "cm"}}
  ],
  "runTitle": "{Type} · {Tags}",
  "runFields": ["Type", "Era", "Start", "End", "Tags", "Comments"],
  "display": [
    {"table": "HGCHit", "repr": "cells", "group": "HGCal MCT", "label": "Rechits", "position": ["x", "y", "z"],
     "colour": "nmips", "palette": "heat", "size": "cellSize", "visible": true,
     "cut": {"group": "Rechit energy", "column": "energy", "unit": "GeV", "default": 0.0}},
    {"table": "HGCLayerClusters", "repr": "markers", "group": "HGCal MCT", "label": "Layer clusters",
     "position": ["x", "y", "z"], "colour": "energy", "palette": "cool", "size": null, "visible": true},
    {"table": "HGCChannel", "repr": "cells", "group": "Detector", "label": "Readout channels", "position": ["x", "y", "z"],
     "size": "cellSize", "colourBy": {"category": "module"}, "context": true, "dim": 0.8, "visible": true}
  ]
}
