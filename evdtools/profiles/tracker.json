{
  "name": "tracker",
  "note": "CMS Phase-2 tracker: tables of Fireworks/EventExport preset tracker. Tracks (generalTracks, in collection order) drawn as helices from their reference point to their outermost hit, high purity, pt >= 1 GeV and from the primary vertex (PV0) by default; offline primary vertices; the hits on each track (valid pixel and outer-tracker hits, positions from their clusters, mid-strip on the outer tracker), shown for a selection; the beam spot. Used alone, or with hgcal through cms.json.",
  "internal": ["VertexTracks"],
  "relations": [
    {"name": "trackVertex", "kind": "index", "from": "Tracks", "to": "Vertices", "index": "Tracks.vertexIdx"},
    {"name": "vertexTracks", "kind": "links", "from": "Vertices", "to": "Tracks", "table": "VertexTracks",
     "fromIndex": "VertexTracks.vertexIdx", "toIndex": "VertexTracks.trackIdx", "weights": ["VertexTracks.weight"]},
    {"name": "trackHits", "kind": "index", "from": "Tracks", "to": "TrackHits", "index": "TrackHits.trackIdx"}
  ],
  "kinds": {
    "vertex": {"label": "Vertices", "repr": "markers", "domain": "Tracker", "colourBy": "row", "visible": true},
    "track": {"label": "Tracks", "repr": "helix", "domain": "Tracker", "visible": true, "onSelection": false,
              "cut": {"group": "Track pT", "unit": "GeV", "default": 1.0}},
    "trackHit": {"label": "Track hits", "repr": "markers", "domain": "Tracker", "visible": true, "onSelection": true,
                 "colourBy": {"category": "subdet", "names": {"1": "pixel barrel", "2": "pixel endcap", "5": "outer tracker barrel", "4": "outer tracker endcap"}}},
    "beamSpot": {"label": "Beam spot", "repr": "markers", "visible": false}
  },
  "display": [
    {"table": "Vertices", "kind": "vertex", "label": "Primary vertices", "position": ["x", "y", "z"], "size": "sumPt2",
     "describe": {"columns": ["nTracks", "sumPt2"]}},
    {"table": "Tracks", "kind": "track", "label": "General tracks", "position": ["vx", "vy", "vz"],
     "momentum": ["px", "py", "pz"], "charge": "charge", "end": ["outerX", "outerY", "outerZ"], "colour": "pt",
     "size": null, "cut": {"column": "pt"}, "filter": "highPurity == 1 && vertexIdx == 0",
     "describe": {"columns": ["pt", "eta"]}},
    {"table": "TrackHits", "kind": "trackHit", "label": "Hits on tracks", "position": ["x", "y", "z"], "size": null,
     "describe": {"columns": ["subdet", "layer"], "names": {"subdet": {"1": "PXB", "2": "PXF", "5": "OT barrel", "4": "OT endcap"}}}},
    {"table": "BeamSpot", "kind": "beamSpot", "label": "Beam spot", "position": ["x", "y", "z"], "size": null}
  ],
  "presets": [
    {"name": "Primary vertex", "filters": {"Tracks": "highPurity == 1 && vertexIdx == 0"}},
    {"name": "All vertices", "filters": {"Tracks": "highPurity == 1"}, "colour": {"Tracks": "rel:trackVertex"}}
  ]
}
